@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap');

:root{
  --ink:#173234; --muted:#617173; --cream:#f6f3ec; --sand:#e9e0d2;
  --sea:#3e7775; --white:#fff; --line:rgba(23,50,52,.12);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;color:var(--ink);background:var(--cream);font-family:"DM Sans",sans-serif;line-height:1.6}
a{color:inherit;text-decoration:none}
.site-header{height:82px;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;background:rgba(246,243,236,.96);position:sticky;top:0;z-index:10;border-bottom:1px solid var(--line)}
.logo{font-weight:600;font-size:21px;letter-spacing:-.5px}.logo span{font-family:"Playfair Display",serif;font-style:italic;font-weight:500}
nav{display:flex;gap:30px;font-size:14px;color:#4f6162}
nav a:hover{color:var(--sea)}
.header-btn{padding:11px 19px;border:1px solid var(--ink);border-radius:30px;font-size:13px}
.hero{min-height:calc(100vh - 82px);position:relative;display:flex;align-items:flex-end;padding:8vw 7vw;overflow:hidden;background:
linear-gradient(120deg,rgba(26,53,55,.92),rgba(35,75,76,.6) 55%,rgba(20,35,35,.25)),
url("hero-placeholder.jpg") center/cover no-repeat,#315b5b}
.hero-content{position:relative;z-index:2;max-width:750px;color:white}
.eyebrow,.section-kicker{font-size:11px;text-transform:uppercase;letter-spacing:2.5px;font-weight:600}
.hero h1{font:500 clamp(48px,7vw,92px)/.98 "Playfair Display",serif;letter-spacing:-3px;margin:18px 0 24px}
.hero h1 em{font-style:italic}
.hero-text{max-width:590px;font-size:17px;color:rgba(255,255,255,.86)}
.hero-actions{display:flex;gap:12px;margin-top:34px}
.button{display:inline-block;padding:14px 24px;border-radius:30px;font-weight:600;font-size:13px;transition:.2s}
.primary{background:var(--ink);color:white}.hero .primary{background:white;color:var(--ink)}
.ghost{border:1px solid rgba(255,255,255,.55);color:white}
.button:hover{transform:translateY(-2px)}
.hero-note{position:absolute;right:6vw;bottom:6vw;color:white;font-size:12px;writing-mode:vertical-rl;opacity:.7}
.section{padding:110px 7vw}
.intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:9vw;margin-top:20px}
h2{font:500 clamp(42px,5vw,68px)/1.05 "Playfair Display",serif;letter-spacing:-2px;margin:10px 0 25px}
.intro-copy{max-width:520px;font-size:17px;color:var(--muted);padding-top:15px}
.intro-copy p+p{margin-top:22px}
.feature-band{background:var(--sand);display:grid;grid-template-columns:repeat(4,1fr);padding:36px 7vw}
.feature-band div{display:flex;flex-direction:column;gap:2px;border-left:1px solid var(--line);padding-left:25px}
.feature-band div:first-child{border:0}.feature-band strong{font:500 29px "Playfair Display",serif}.feature-band span{font-size:12px;color:var(--muted)}
.section-heading,.gallery-heading{display:flex;justify-content:space-between;gap:40px;align-items:end;margin-bottom:45px}
.section-heading>p,.gallery-heading>p{max-width:400px;color:var(--muted);font-size:15px}
.amenity-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line)}
.amenity-grid article{padding:30px 30px 35px 0;border-bottom:1px solid var(--line)}
.amenity-grid article:not(:nth-child(3n+1)){padding-left:30px;border-left:1px solid var(--line)}
.amenity-grid span{font-size:11px;color:var(--sea)}.amenity-grid h3{font:500 23px "Playfair Display",serif;margin:15px 0 6px}.amenity-grid p{color:var(--muted);font-size:14px;margin:0}
.gallery{background:#e9e5dc}.gallery-heading{margin-top:-8px}.gallery-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px}
.photo{height:370px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#cad7d1,#a9c1bc);position:relative;overflow:hidden}
.photo-large{height:480px}.photo span{padding:10px 15px;background:rgba(255,255,255,.82);border-radius:30px;font-size:12px;color:var(--ink)}
.booking{padding-top:80px;padding-bottom:80px}
.booking-card{background:#d4dfd9;padding:65px 7vw;display:grid;grid-template-columns:1.2fr .8fr;gap:80px;align-items:center}
.booking-card p{max-width:560px;color:#526767}
.contact-box{display:flex;flex-direction:column;align-items:flex-start;gap:10px}.contact-box>a:not(.button){font-size:18px}.contact-box .button{margin-top:15px}
footer{padding:35px 7vw;display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);font-size:12px;color:var(--muted)}
footer .logo{color:var(--ink)}
@media(max-width:800px){
 .site-header{height:auto;min-height:70px;padding:15px 5vw}.site-header nav{display:none}.header-btn{padding:9px 14px}
 .hero{min-height:680px;padding:55px 6vw}.hero h1{letter-spacing:-2px}.hero-text{font-size:15px}
 .intro-grid,.booking-card{grid-template-columns:1fr;gap:20px}.section{padding:75px 6vw}
 .feature-band{grid-template-columns:1fr 1fr;gap:25px;padding:30px 6vw}.feature-band div:nth-child(3){border-left:0;padding-left:0}
 .amenity-grid{grid-template-columns:1fr}.amenity-grid article:not(:nth-child(3n+1)){padding-left:0;border-left:0}
 .section-heading,.gallery-heading{display:block}.section-heading>p,.gallery-heading>p{margin-top:20px}
 .gallery-grid{grid-template-columns:1fr}.photo,.photo-large{height:300px}
 .booking-card{padding:45px 7vw}.booking{padding-top:45px}
 footer{flex-direction:column;gap:10px;align-items:flex-start}
}

<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Морская Дача — отдых у моря</title>
  <meta name="description" content="Уютная дача у моря для спокойного отдыха.">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="site-header">
    <a class="logo" href="#top">Морская<span>Дача</span></a>
    <nav>
      <a href="#about">О даче</a>
      <a href="#amenities">Удобства</a>
      <a href="#gallery">Фото</a>
      <a href="#booking">Бронирование</a>
    </nav>
    <a class="header-btn" href="#booking">Забронировать</a>
  </header>

  <main id="top">
    <section class="hero">
      <!-- Замените hero-placeholder.jpg на свою фотографию -->
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <p class="eyebrow">Тишина • море • свежий воздух</p>
        <h1>Дача у моря,<br><em>куда хочется вернуться</em></h1>
        <p class="hero-text">Уютный дом для отдыха вдали от городской суеты. Море рядом, закаты перед глазами, а всё необходимое — под рукой.</p>
        <div class="hero-actions">
          <a class="button primary" href="#booking">Узнать о датах</a>
          <a class="button ghost" href="#about">Посмотреть дачу</a>
        </div>
      </div>
      <div class="hero-note">Ваше место для отдыха</div>
    </section>

    <section class="intro section" id="about">
      <div class="section-kicker">О месте</div>
      <div class="intro-grid">
        <div>
          <h2>Несколько дней<br>у самого моря.</h2>
        </div>
        <div class="intro-copy">
          <p>Здесь можно просыпаться без будильника, завтракать на свежем воздухе и вечером смотреть, как солнце уходит за горизонт.</p>
          <p>Дача подойдёт для пары, семьи или небольшой компании друзей. Вы получаете отдельное пространство и настоящий отдых в своём ритме.</p>
        </div>
      </div>
    </section>

    <section class="feature-band">
      <div><strong>5 мин</strong><span>до моря</span></div>
      <div><strong>4–6</strong><span>гостей</span></div>
      <div><strong>24/7</strong><span>отдельный дом</span></div>
      <div><strong>Wi‑Fi</strong><span>быстрый интернет</span></div>
    </section>

    <section class="section amenities" id="amenities">
      <div class="section-heading">
        <div>
          <div class="section-kicker">Всё для отдыха</div>
          <h2>Удобства</h2>
        </div>
        <p>Собрали главное, чтобы вам оставалось только приехать и наслаждаться отдыхом.</p>
      </div>
      <div class="amenity-grid">
        <article><span>01</span><h3>Отдельная дача</h3><p>Пространство только для вас и ваших близких.</p></article>
        <article><span>02</span><h3>Кухня</h3><p>Всё необходимое для завтраков, ужинов и долгих разговоров.</p></article>
        <article><span>03</span><h3>Терраса</h3><p>Место для утреннего кофе и вечерних посиделок.</p></article>
        <article><span>04</span><h3>Парковка</h3><p>Можно спокойно приехать на автомобиле.</p></article>
        <article><span>05</span><h3>Мангал</h3><p>Устройте ужин на свежем воздухе.</p></article>
        <article><span>06</span><h3>Wi‑Fi</h3><p>Если всё-таки понадобится оставаться на связи.</p></article>
      </div>
    </section>

    <section class="gallery section" id="gallery">
      <div class="section-kicker">Атмосфера</div>
      <div class="gallery-heading"><h2>Фото</h2><p>Здесь позже появятся ваши фотографии дачи, моря и территории.</p></div>
      <div class="gallery-grid">
        <div class="photo photo-large"><span>Добавьте фото</span></div>
        <div class="photo"><span>Добавьте фото</span></div>
        <div class="photo"><span>Добавьте фото</span></div>
      </div>
    </section>

    <section class="booking section" id="booking">
      <div class="booking-card">
        <div>
          <div class="section-kicker">Бронирование</div>
          <h2>Готовы к отдыху?</h2>
          <p>Напишите нам, укажите желаемые даты и количество гостей. Мы ответим и расскажем о свободных датах.</p>
        </div>
        <div class="contact-box">
          <a href="tel:+70000000000">+7 (000) 000‑00‑00</a>
          <a href="mailto:hello@example.com">hello@example.com</a>
          <a class="button primary" href="https://wa.me/70000000000">Написать в WhatsApp</a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="logo">Морская<span>Дача</span></div>
    <p>Ваш отдых начинается здесь.</p>
    <p>© 2026</p>
  </footer>
</body>
</html>
